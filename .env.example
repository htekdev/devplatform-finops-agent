# GitHub Configuration
# Create a Personal Access Token with 'admin:org' and 'repo' scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORGS=org1,org2,org3

# Azure DevOps Configuration
# Create a Personal Access Token with 'vso.agentpools', 'vso.build', 'vso.memberentitlementmanagement' scopes
AZDO_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZDO_ORGS=org1,org2,org3

# Logging
# Supported levels: debug, info, warn, error
LOG_LEVEL=info

# Cache Configuration
# TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600
CACHE_DIR=./.cache

# Reporting Configuration
REPORT_OUTPUT_DIR=./reports
