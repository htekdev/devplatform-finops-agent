# GitHub Authentication
# Required scopes: repo, admin:org (for billing data)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure DevOps Authentication
# Required scopes: User Entitlements (Read), Agent Pools (Read), Build (Read)
AZURE_DEVOPS_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_DEVOPS_ORG=your-org-name

# Optional: Custom pricing data location
# PRICING_DATA_PATH=/path/to/pricing.json

# Optional: LLM Configuration
# COPILOT_MODEL=gpt-4o
