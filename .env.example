# GitHub Configuration (Optional - at least one platform required)
# Required scopes: read:org, read:billing
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORGS=org1,org2

# Azure DevOps Configuration (Optional - at least one platform required)
# Required scopes: vso.memberentitlementmanagement, vso.agentpools, vso.build
AZURE_DEVOPS_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_DEVOPS_ORG=your-org-name

# Optional: Custom pricing data location
# PRICING_DATA_PATH=/path/to/pricing.json

# Optional: LLM Configuration (defaults to gpt-4o)
# COPILOT_MODEL=gpt-4o

# Optional: Thresholds
# INACTIVE_DAYS=90  # Days to flag inactive users
# MIN_SAVINGS_TO_REPORT=10  # Minimum monthly savings to include in report

