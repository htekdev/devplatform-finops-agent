# GitHub Authentication
# Option 1: Explicit token (recommended for CI/CD)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Option 2: Use GitHub CLI (run: gh auth login)
# GH_TOKEN will be discovered automatically by octokit-from-auth

# Azure DevOps Authentication
# Option 1: Personal Access Token
AZURE_DEVOPS_PAT=your_azure_devops_personal_access_token

# Option 2: Use Azure CLI (run: az login)
# DefaultAzureCredential will discover tokens automatically

# Azure DevOps Organization
AZURE_DEVOPS_ORG=your-organization-name

# Optional: Custom pricing overrides (if default pricing is stale)
# PRICING_GITHUB_ACTIONS_UBUNTU=0.008
# PRICING_GITHUB_ACTIONS_WINDOWS=0.016
# PRICING_GITHUB_ACTIONS_MACOS=0.08
# PRICING_GITHUB_LFS_STORAGE=0.07
# PRICING_GITHUB_LFS_BANDWIDTH=0.0875
# PRICING_AZDO_PARALLEL_JOB_HOSTED=40
# PRICING_AZDO_PARALLEL_JOB_SELFHOSTED=15
# PRICING_AZDO_LICENSE_BASIC=6
# PRICING_AZDO_LICENSE_BASIC_TEST_PLANS=52
